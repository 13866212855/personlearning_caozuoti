# GEMINI_API_KEY: Required for Gemini AI API calls if used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# JWT Secrets (set strong random strings in production)
STUDENT_JWT_SECRET="it_exam_student_jwt_secret_change_in_prod"
ADMIN_JWT_SECRET="it_exam_admin_jwt_secret_change_in_prod"

# Platform integration (personlearning). Details: 成员验证对接平台-设计文档.md
# redeploy.bat passes AUTH_MODE and the PLATFORM_* addresses itself and writes the JWT secrets
# to D:\docker\personlearning_caozuoti\.env on first run (docker --env-file format: KEY=VALUE, no quotes).
# Anything you add to that file must use the bare format, e.g. PLATFORM_STUDENT_DIRECT_LOGIN=deny
AUTH_MODE="local"
PLATFORM_BASE_URL="http://adaptive-learning-backend:3000"
PLATFORM_WEB_URL="http://192.168.123.3:7669"
PLATFORM_SSO_ENABLED="false"
# warn (default): students may sign in with a password but are warned | deny: platform entry only | allow
PLATFORM_STUDENT_DIRECT_LOGIN="warn"
PLATFORM_TIMEOUT_MS="6000"

# Default LLM Configuration (seeded into SQLite on first launch, editable in /admin)
LLM_BASE_URL="https://apihub.agnes-ai.com/v1"
LLM_API_KEY=""
LLM_TEXT_MODEL="agnes-2.5-flash"
LLM_IMAGE_MODEL="agnes-image-2.1-flash"
