# GEMINI_API_KEY: Required for Gemini AI API calls if used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# JWT Secrets (set strong random strings in production)
STUDENT_JWT_SECRET="it_exam_student_jwt_secret_change_in_prod"
ADMIN_JWT_SECRET="it_exam_admin_jwt_secret_change_in_prod"

# Default LLM Configuration (seeded into SQLite on first launch, editable in /admin)
LLM_BASE_URL="https://apihub.agnes-ai.com/v1"
LLM_API_KEY=""
LLM_TEXT_MODEL="Agnes-2.5-flash"
LLM_IMAGE_MODEL="Agnes-Image-2.1-flash"
